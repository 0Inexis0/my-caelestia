{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": false
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "persistent": true,
        "scrollActions": {
            "workspaces": true
        },
        "tray": {
            "background": false,
            "recolour": false
        },
        "workspaces": {
            "activeTrail": false,
            "occupiedBg": false,
            "showWindows": true,
            "shown": 3
        }
    },
    "general": {
        "idle": {
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 180
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 300
                },
                {
                    "idleAction": [
                        "suspend"
                    ],
                    "timeout": 600
                }
            ]
        }
    },
    "launcher": {
        "actionPrefix": "."
    },
    "paths": {
        "wallpaperDir": "~/Pictures/Wallpapers"
    }
}
